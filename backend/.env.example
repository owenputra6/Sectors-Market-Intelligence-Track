SECTORS_API_KEY=
SECTORS_BASE_URL=https://api.sectors.app/v2
SECTORS_CACHE_TTL_SECONDS=604800
SECTORS_MAX_RETRIES=0
# Minimum spacing between provider requests; protects lower-rate API plans.
SECTORS_REQUEST_MIN_INTERVAL_SECONDS=2.1
WEEKLY_REFRESH_ENABLED=false
# Set WEEKLY_REFRESH_ENABLED=false to serve only existing CSV/request-cache data.
# CACHE_ONLY_MODE=true can also force this behavior while testing.
# Cache-only mode never calls Sectors and marks the API/UI data as partial/stale.
CACHE_ONLY_MODE=true
WEEKLY_CREDIT_BUDGET=550
# Optional benchmark filter. Leave COHORT_INDEX blank for market-cap or sector cohorts.
COHORT_INDEX=KOMPAS100
COHORT_SIZE=100
# Optional exact API screener filters. Example: COHORT_SECTOR=Financials,
# COHORT_SUBSECTOR=Banks, COHORT_SIZE=20.
COHORT_SECTOR=
COHORT_SUBSECTOR=
# Comma-separated exact sector names for refresh_selected_sectors.py.
# COHORT_SIZE=0 means every company returned for the selected sectors.
COHORT_SECTORS=
# Optional extra companies outside the selected cohort; empty is universal default.
TRACKED_TICKERS=
MIN_VALID_PEERS=5
MAX_MISSING_FEATURE_RATE=0.35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
